# コピー: cp env.example .env.local (Windows: copy env.example .env.local)
# 必須: NextAuth.js v5。生成例: openssl rand -base64 32
AUTH_SECRET=

# 必須: Supabase (https://supabase.com/dashboard → プロジェクト → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 任意: Google ログイン (https://console.cloud.google.com/apis/credentials)
# リダイレクト URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=